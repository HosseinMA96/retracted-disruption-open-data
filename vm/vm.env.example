# Project E VM, restored from the Project D archive snapshot (never modify the snapshot: it is D's archive).
# The disk holds C's graph tables (~/c/data/work) and D's work tables (~/d/data/work), both read only for E.
RG=rg-project-e
VM=vm-project-e
LOCATION=eastus
SNAPSHOT_ID=/subscriptions/<subscription-id>/resourceGroups/<rg>/providers/Microsoft.Compute/snapshots/<snapshot>
SIZE=Standard_E8s_v6                 # 8 vCPU / 64 GB, $0.529/h
DISK_CONTROLLER=NVMe
DISK_GB=256
DISK_SKU=Premium_LRS
ADMIN=azureuser
AUTO_SHUTDOWN_UTC=1500           # backstop only; run_all.sh deallocates the VM when it ends
